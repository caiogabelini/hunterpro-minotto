# Copie para .env e preencha com valores reais. NUNCA commitar o .env de verdade.

ENVIRONMENT=development

# --- Banco de dados ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hunterpro_minotto

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Auth ---
SECRET_KEY=troque-por-uma-chave-aleatoria-forte

# --- APIs de enriquecimento ---
GOOGLE_API_KEY=
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
SERP_API_KEY=
ANTHROPIC_API_KEY=

EVOLUTION_URL=
EVOLUTION_KEY=
EVOLUTION_INSTANCE=

# --- Fontes do nicho de saúde ---
PGFN_DADOS_ABERTOS_DIR=./data/pgfn
CNES_API_BASE_URL=https://apidadosabertos.saude.gov.br

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
