# =============================================================================
# HunterPro — Minotto Contabilidade · variáveis de ambiente de PRODUÇÃO
# =============================================================================
#
# Este arquivo é DOCUMENTAÇÃO, não um arquivo pra subir no servidor. Em
# produção nada disso vem de arquivo: cada variável é cadastrada na aba
# "Environment" do App Service no EasyPanel. O .dockerignore inclusive
# barra qualquer .env de entrar na imagem, de propósito.
#
# As MESMAS variáveis valem pros DOIS serviços que rodam esta imagem --
# backend (uvicorn) e worker (celery). A imagem é a mesma, só o comando
# de start muda. Se uma variável for cadastrada só no backend, a task do
# Celery que depende dela falha silenciosamente no worker. Ver README,
# seção "Deploy em Produção".
#
# =============================================================================
# 1. INFRAESTRUTURA INTERNA (Postgres e Redis)
# =============================================================================
#
# ATENÇÃO -- este é o erro mais comum no primeiro deploy: em produção
# NUNCA use localhost/127.0.0.1 aqui. Postgres e Redis são serviços
# separados na rede interna do EasyPanel, e o host é o NOME DO SERVIÇO,
# resolvido pelo DNS interno. "localhost" dentro do container do backend
# é o próprio container do backend, onde não há banco nenhum rodando.
#
# Substitua os nomes abaixo pelos nomes reais dos serviços criados no
# painel, e a senha pela que o EasyPanel gerou ao criar o Postgres.

DATABASE_URL=postgresql://postgres:SENHA_GERADA_PELO_EASYPANEL@hunterpro-minotto-postgres:5432/hunterpro_minotto

# Redis: um índice por finalidade, no mesmo servidor.
#   /0 -> broker do Celery (fila de tasks)
#   /1 -> backend de resultados do Celery
#   REDIS_URL (/0) é usado direto pelo cache do índice da PGFN
#   (app/services/pgfn.py), separado do uso pelo Celery.
REDIS_URL=redis://hunterpro-minotto-redis:6379/0
CELERY_BROKER_URL=redis://hunterpro-minotto-redis:6379/0
CELERY_RESULT_BACKEND=redis://hunterpro-minotto-redis:6379/1

# =============================================================================
# 2. AUTENTICAÇÃO
# =============================================================================
#
# SECRET_KEY assina os JWTs. Precisa ser um valor NOVO e forte, gerado
# só pra produção -- nunca o "changeme-in-env" do config.py nem o valor
# do .env de desenvolvimento. Quem tem essa chave consegue forjar um
# token de admin válido.
#
# Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Trocar essa chave depois invalida todos os tokens em circulação (todo
# mundo é deslogado). Não é destrutivo, mas não faça isso no meio do dia.
SECRET_KEY=GERE_UM_VALOR_NOVO_E_FORTE_AQUI

# Validade do token em minutos (padrão do código: 720 = 12h).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# =============================================================================
# 3. CORS
# =============================================================================
#
# Em produção o nginx do frontend faz proxy de /api/ pro backend, então
# o navegador vê tudo na mesma origem e NÃO existe requisição
# cross-origin -- ou seja, na arquitetura atual o CORS não é o que faz a
# aplicação funcionar. Configure mesmo assim: é defesa em profundidade e
# passa a ser essencial se algum dia o backend ganhar domínio próprio.
FRONTEND_ORIGIN=https://minotto.4handsai.com.br

# =============================================================================
# 4. CHAVES DE API DAS INTEGRAÇÕES DE ENRIQUECIMENTO
# =============================================================================
#
# Sem chave, a etapa correspondente do pipeline é PULADA com um motivo
# logado -- não derruba o pipeline (ver _rodar_etapa em
# app/workers/celery_app.py). Ou seja: uma chave faltando não quebra o
# deploy, só produz leads com menos dados e score mais baixo, o que é
# bem mais difícil de perceber. Confira as 8 antes de rodar a primeira
# busca de verdade.

# 1. Google Places API (New) -- Text Search por CNPJ/razão social, traz
#    site, telefone e rating. É a origem automática do site_url usado
#    pelo Firecrawl. Cobrada por request; ative a "Places API (New)" no
#    Google Cloud e restrinja a chave.
GOOGLE_API_KEY=

# 2. Hunter.io -- Email Finder (descobre o e-mail do decisor a partir do
#    domínio + nome). Plano pago, com cota mensal de buscas.
HUNTER_API_KEY=

# 3. ZeroBounce -- validação do e-mail encontrado pelo Hunter. Cobrada
#    por crédito; só é chamada depois do MX check passar, justamente pra
#    não gastar crédito à toa.
ZEROBOUNCE_API_KEY=

# 4. Anthropic (Claude) -- inferência sobre o conteúdo do site,
#    mensagens de abordagem (e-mail/WhatsApp) e insights estratégicos.
#    Modelo usado: claude-haiku-4-5-20251001. É a chave com uso mais
#    frequente: além do pipeline, é acionada por clique de usuário nos
#    botões "Gerar" do dossiê.
ANTHROPIC_API_KEY=

# 5. Firecrawl -- scraping do site do lead em markdown, de onde saem o
#    resumo do conteúdo e o link do Instagram. Cobrada por página.
FIRECRAWL_API_KEY=

# 6-8. Evolution API -- validação de WhatsApp (confirma se o número tem
#    conta ativa). As três variáveis são obrigatórias juntas; faltando
#    qualquer uma, a etapa é pulada. A URL é da SUA instância da
#    Evolution, não um endpoint público.
EVOLUTION_URL=https://sua-instancia-evolution.com.br
EVOLUTION_KEY=
EVOLUTION_INSTANCE=

# --- NÃO configure: declarada no config.py mas sem nenhum uso no código ---
# SERP_API_KEY foi declarada em app/core/config.py numa sessão inicial e
# nunca chegou a ser usada (`grep settings.SERP_API_KEY app/` não retorna
# nada, conferido em 22/08/2026). Não cadastre no EasyPanel; se um dia
# alguma etapa passar a usar SerpAPI, esta linha vira obrigatória.
# SERP_API_KEY=

# =============================================================================
# 5. ARQUIVOS DE DADOS ABERTOS (PGFN e Receita Federal)
# =============================================================================
#
# ATENÇÃO -- estes caminhos são DENTRO do container, e o sistema de
# arquivos do container é efêmero: some a cada redeploy. Pra que
# `refresh_pgfn_index` e `gerar_semente_leads` funcionem em produção, o
# EasyPanel precisa ter um VOLUME PERSISTENTE montado nesses caminhos, no
# serviço do WORKER (é ele quem lê os arquivos), e os arquivos precisam
# ser enviados manualmente pra lá -- não há download automático
# implementado ainda.
#
# Sem o volume, `gerar_semente_leads` devolve a forma "sem_arquivos" e a
# busca mensal conclui com 0 CNPJs encontrados, sem erro aparente.
PGFN_DADOS_ABERTOS_DIR=/app/data/pgfn
RECEITA_FEDERAL_DADOS_ABERTOS_DIR=/app/data/receita_federal

# =============================================================================
# 6. APIs PÚBLICAS (sem autenticação) — só mude se o endpoint mudar
# =============================================================================
CNES_API_BASE_URL=https://apidadosabertos.saude.gov.br
RECEITA_FEDERAL_API_BASE_URL=https://brasilapi.com.br
IBGE_API_BASE_URL=https://servicodados.ibge.gov.br

# =============================================================================
# 7. AJUSTES DA APLICAÇÃO
# =============================================================================

# Limite de leads/mês do plano, mostrado na seção "Consumo do Plano" do
# dashboard. Hoje é um valor global fixo (não há conceito de plano por
# cliente).
PLANO_LEADS_MES=50

# Espera do Postgres no boot (scripts/wait_for_db.py, chamado pelo
# entrypoint.sh). Só mexa se o Postgres do EasyPanel estiver demorando
# mais que 60s pra aceitar conexão depois de um redeploy.
WAIT_FOR_DB_TIMEOUT=60
WAIT_FOR_DB_INTERVALO_MAX=5

# --- Opcional: declarada no config.py mas sem uso no código ---
# ENVIRONMENT existe em app/core/config.py e nada a lê (conferido em
# 22/08/2026). Cadastrar é inofensivo e serve de rótulo, mas não muda
# comportamento nenhum da aplicação.
# ENVIRONMENT=production
